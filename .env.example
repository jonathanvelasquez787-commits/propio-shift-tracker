# Variables de entorno de las Vercel Functions (api/).
# Se configuran en Vercel → Project Settings → Environment Variables.
# Este archivo es solo la plantilla: NUNCA se sube con valores reales.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API → anon public
# (la misma que va en js/config.js; es pública, la protege RLS)
SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase → Project Settings → API → service_role  ⚠️ SECRETA
# Salta TODAS las políticas de RLS. Solo en el servidor. Si se filtra,
# hay que rotarla de inmediato desde el panel de Supabase.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
