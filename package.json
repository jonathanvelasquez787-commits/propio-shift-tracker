{
  "name": "propio-shift-tracker",
  "version": "597.0.0",
  "private": true,
  "description": "Registro personal de turnos, llamadas y ganancias — con cuentas y respaldo en la nube.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:extension": "node scripts/build-extension.mjs",
    "build:summary": "node scripts/build-summary-extension.mjs",
    "build": "node scripts/check-i18n.mjs && node scripts/check-module-exports.mjs && node scripts/check-ui-wiring.mjs && node scripts/build.mjs",
    "check:modules": "node scripts/check-module-exports.mjs",
    "test": "node scripts/check-i18n.mjs && node --test",
    "check:ui": "node scripts/check-ui-wiring.mjs",
    "i18n:extract": "node scripts/extract-i18n.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "i18n:sync": "node scripts/sync-translations.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "i18next": "26.4.2"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "15.2.3",
    "acorn": "8.15.0",
    "locize-cli": "12.8.3",
    "parse5": "7.3.0",
    "rollup": "3.30.0",
    "terser": "5.44.0"
  }
}
