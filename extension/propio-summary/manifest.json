{
  "manifest_version": 3,
  "name": "Propio · Minutos y ganancias",
  "description": "Suma los minutos y el pago del historial de Propio. Herramienta independiente y local.",
  "version": "1.0.2",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["https://interpreters.propio-ls.com/*"],
  "action": { "default_title": "Propio · Minutos y ganancias", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://interpreters.propio-ls.com/*"], "js": ["summary.js"], "run_at": "document_idle" }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
