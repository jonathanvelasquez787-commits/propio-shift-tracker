{
  "manifest_version": 3,
  "name": "Shift Tracker Bridge para Propio",
  "description": "Conecta las señales de llamadas de Propio con tu Shift Tracker. Extensión independiente; empieza en observación.",
  "version": "1.3.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "webRequest", "alarms"],
  "host_permissions": ["https://interpreters.propio-ls.com/*", "https://eventgw.twilio.com/*", "https://propio-shift-tracker.vercel.app/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "Shift Tracker Bridge", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://propio-shift-tracker.vercel.app/*"], "js": ["tracker-content.js"], "run_at": "document_start" }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
